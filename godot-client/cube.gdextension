[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

; Android libraries are produced by scripts/build-android.sh into bin/android/<abi>/ (inside res:// so export includes them).
; Desktop paths point at the Cargo target directory next to this project (outside res://, works in the editor;
; for exports the libraries must be copied into the project, see docs/spike/rust-godot/build-and-targets.md).
[libraries]
windows.debug.x86_64 = "res://../target/debug/cube_godot_adapter.dll"
windows.release.x86_64 = "res://../target/release/cube_godot_adapter.dll"
android.debug.arm64 = "res://bin/android/arm64/libcube_godot_adapter.so"
android.release.arm64 = "res://bin/android/arm64/libcube_godot_adapter.so"
android.debug.x86_64 = "res://bin/android/x86_64/libcube_godot_adapter.so"
android.release.x86_64 = "res://bin/android/x86_64/libcube_godot_adapter.so"
ios.debug.arm64 = "res://../target/aarch64-apple-ios/debug/libcube_godot_adapter.dylib"
ios.release.arm64 = "res://../target/aarch64-apple-ios/release/libcube_godot_adapter.dylib"
