{
  "name": "protect-dev-master",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/dev", "refs/heads/master"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "fmt" },
          { "context": "clippy" },
          { "context": "test (ubuntu-latest)" },
          { "context": "test (windows-latest)" },
          { "context": "deny" },
          { "context": "archcheck" }
        ]
      }
    }
  ],
  "bypass_actors": []
}
