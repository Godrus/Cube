; Engine configuration file for the first Cube world (Godot 4.2+).
; GDScript here is UI and glue only (ADP-02): input and the camera node. The world, the
; geometry and every edit live in the Rust library (see cube.gdextension).

config_version=5

[application]

config/name="Cube - first world"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
